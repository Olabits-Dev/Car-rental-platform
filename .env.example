# Copy this file to `.env.local` for local development.
# Set the same keys in your hosting provider dashboard for production.

# Required for signing auth cookies.
# Generate a long random value, for example:
# openssl rand -base64 32
SESSION_SECRET=
BACKEND_PORT=4000
BACKEND_API_URL=https://car-rental-platform-xlam.vercel.app/api/backend

# Postgres / Neon
DATABASE_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Seeded backend users
OWNER_EMAIL=
OWNER_PASSWORD=
AGENT_EMAIL=
AGENT_PASSWORD=
